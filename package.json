{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:frontend": "tsx --test src/config/*.test.ts src/lib/*.test.ts src/data/*.test.ts src/data/repositories/*.test.ts",
    "test:server": "tsx --test server/server.test.ts",
    "test:admin": "tsx --test server/admin/*.test.ts",
    "test:rules": "npx --yes firebase-tools emulators:exec --project demo-kopi-rules-test --config firebase.emulator.json --only firestore \"tsx --test firestore.rules.test.ts\"",
    "admin:verify": "tsx server/admin/cli.ts verify-connection",
    "admin:inventory": "tsx server/admin/cli.ts inventory-published",
    "admin:seed:dry-run": "tsx server/admin/cli.ts seed-demo --dry-run",
    "admin:seed": "tsx server/admin/cli.ts seed-demo",
    "admin:ingest": "tsx server/admin/cli.ts ingest",
    "test": "tsx --test src/config/*.test.ts src/lib/*.test.ts src/data/*.test.ts src/data/repositories/*.test.ts server/server.test.ts server/admin/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
